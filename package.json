{
  "name": "jiuge-ai-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "import": "node scripts/import-articles.mjs",
    "predev": "npm run import",
    "dev": "vitepress dev docs",
    "prebuild": "npm run import",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "cf:preview": "wrangler pages dev docs/.vitepress/dist",
