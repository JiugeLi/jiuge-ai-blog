    "gray-matter": "^4.0.3",
    "markdown-it": "^14.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "feed": "^6.0.0",
    "markdown-it-cjk-friendly": "^3.0.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.110.0"
  }
}
